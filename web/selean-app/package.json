{
  "name": "selean-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-wasm.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "wasm:build": "wasm-pack build ../../crates/selean-wasm --target web --out-dir ../../web/selean-app/src/wasm/pkg",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@webgpu/types": "^0.1.69",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
