# =============================================================================
# Selean Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# The server loads this file at startup from the directory it is started in.
# Variables already set in the environment take precedence.

# --- AI chat ---

# AI chat needs nothing set here. By default it uses a local Ollama server
# (http://localhost:11434/v1) with the model qwen2.5:7b and no API key.
# See "AI chat" in the README for the setup steps.

# Local model to use instead of the default (must support tool calling).
# LLM_MODEL=

# Optional: use another provider with your own key. Leave these empty for
# the free local default. Never commit a real key.
#
# LLM_PROVIDER: openai-compatible (default) or anthropic.
# LLM_BASE_URL: API root of an OpenAI-compatible server,
#   e.g. https://openrouter.ai/api/v1
# LLM_API_KEY: key for that server; not needed for local Ollama.
# ANTHROPIC_API_KEY: only read when LLM_PROVIDER=anthropic.
# ANTHROPIC_MODEL: Claude model (default claude-sonnet-4-6).
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Database (optional, enables persistent storage) ---

# PostgreSQL connection URL. When set, the server uses database-backed
# document storage. When unset, falls back to filesystem snapshots only.
# DATABASE_URL=postgres://selean:password@localhost:5432/selean

# Maximum database connection pool size.
# DATABASE_MAX_CONNECTIONS=10

# --- Authentication ---

# JWT secret for user authentication. When set, enables signup/login/refresh
# endpoints and requires JWT Bearer tokens for protected routes. Signup and
# login also need DATABASE_URL. When neither JWT_SECRET nor SELEAN_AUTH_SECRET
# is set, auth is off and the web app runs in guest mode with no login.
# Use a long random string (at least 32 characters).
# JWT_SECRET=your-jwt-secret-here-use-a-long-random-string

# --- S3/R2 Storage (optional, defaults to local filesystem) ---

# S3_BUCKET=selean-assets
# S3_REGION=auto
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Optional ---

# Server port.
# PORT=8080

# Path to built frontend assets.
# STATIC_DIR=web/selean-app/dist

# Shared secret for bearer token auth. When set, all API endpoints
# (except /api/health) require Authorization: Bearer <secret>.
# SELEAN_AUTH_SECRET=your-secret-here

# Directory for collaborative room snapshots.
# SELEAN_DATA_DIR=data/rooms

# Room snapshot interval in seconds.
# SELEAN_SNAPSHOT_INTERVAL=30

# Asset storage directory (local fallback when S3 not configured).
# SELEAN_ASSET_DIR=data/assets

# CORS allowed origins (comma-separated).
# ALLOWED_ORIGINS=http://localhost:3000

# GitHub OAuth (optional, enables "Sign in with GitHub" and code export to repos).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Figma personal access token for Figma import.
# FIGMA_ACCESS_TOKEN=figd_...

# InDesign Server URL for .indd file conversion.
# INDESIGN_SERVER_URL=http://localhost:18383

# Log level (trace, debug, info, warn, error).
# RUST_LOG=info
